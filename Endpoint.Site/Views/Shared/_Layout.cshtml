<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Endpoint.Site</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Endpoint.Site.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="site-shell">
        <header class="site-header">
            <div class="site-header-inner">
                <a class="brand-mark" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon" aria-hidden="true">C</span>
                    <span class="brand-copy">
                        <span class="brand-title">ChatApp</span>
                        <span class="brand-subtitle">Endpoint.Site</span>
                    </span>
                </a>

                <nav class="site-nav" aria-label="Primary">
                    <a class="site-nav-link" asp-area="" asp-controller="Home" asp-action="Index">Workspace</a>
                    <a class="site-nav-link" asp-area="" asp-controller="Conversation" asp-action="Index">Conversations</a>
                    <a class="site-nav-link" asp-area="" asp-controller="Authentication" asp-action="Login">Login</a>
                    <a class="site-nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                </nav>
            </div>
        </header>

        <main class="site-main">
            @RenderBody()
        </main>

        <footer class="site-footer">
            <div class="site-footer-inner">
                <span>&copy; 2026 ChatApp</span>
                <span>MVC front end for API and SignalR testing</span>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
