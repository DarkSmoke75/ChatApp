@using Endpoint.Site.Models.ViewModels.AuthenticationViewModel
@model SignUpViewModel
@{
    ViewData["Title"] = "SignUp";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ثبت نام</title>
    @* <!-- font---------------------------------------->
    <link rel="stylesheet" href="~/SiteTemplate/assets/css/vendor/font-awesome.min.css">
    <link rel="stylesheet" href="~/SiteTemplate/assets/css/vendor/materialdesignicons.css">
    <!-- plugin-------------------------------------->
    <link rel="stylesheet" href="~/SiteTemplate/assets/css/vendor/bootstrap.css">
    <link rel="stylesheet" href="~/SiteTemplate/assets/css/vendor/owl.carousel.min.css">
    <link rel="stylesheet" href="~/SiteTemplate/assets/css/vendor/noUISlider.min.css">
    <!-- main-style---------------------------------->
    <link rel="stylesheet" href="~/SiteTemplate/assets/css/main.css"> *@
</head>
<body>
    <form asp-action="SignUp" asp-controller="Authentication" method="post" class="form-account text-right">

        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-account-title">
            <label>ایمیل</label>
            <input asp-for="Email" class="number-email-input" />
        </div>
        <br />
        <div class="form-account-title">
            <label>رمز عبور</label>
            <input asp-for="Password" type="password" class="password-input" />
        </div>
        <br />

        <div class="form-account-title">
            <label>تکرار رمز عبور</label>
            <input asp-for="RePassword" type="password" class="password-input" />
        </div>
        <br />

        <div class="form-account-title">
            <label>نام کاربری</label>
            <input asp-for="Username" class="number-email-input" />
        </div>
        <br />

        <div class="form-account-title">
            <label>نام نمایشی</label>
            <input asp-for="DisplayName" class="number-email-input" />
        </div>
        <br />
        <br />
        <div class="form-row-account">
            <button type="submit" class="btn btn-primary btn-register">ثبت نام</button>
        </div>

    </form>
</body>

</html>


