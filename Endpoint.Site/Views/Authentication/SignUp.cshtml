@using Endpoint.Site.Models.ViewModels.AuthenticationViewModel
@model SignUpViewModel
@{
    ViewData["Title"] = "Sign Up";
}

<section class="auth-page">
    <div class="auth-shell auth-shell-compact auth-shell-signup">
        <div class="auth-panel auth-form-panel auth-form-panel-compact">
            <div class="auth-form-header">
                <h1>Create account</h1>
                <p>Join the conversation.</p>
            </div>

            <form asp-action="SignUp" asp-controller="Authentication" method="post" class="auth-form">
                <div asp-validation-summary="All" class="validation-summary"></div>

                <div class="field-group">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" class="app-input" placeholder="name@example.com" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <div class="auth-grid">
                    <div class="field-group">
                        <label asp-for="Password"></label>
                        <input asp-for="Password" type="password" class="app-input" placeholder="Password" />
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>

                    <div class="field-group">
                        <label asp-for="RePassword"></label>
                        <input asp-for="RePassword" type="password" class="app-input" placeholder="Repeat password" />
                        <span asp-validation-for="RePassword" class="field-error"></span>
                    </div>
                </div>

                <div class="auth-grid">
                    <div class="field-group">
                        <label asp-for="Username"></label>
                        <input asp-for="Username" class="app-input" placeholder="Username" />
                        <span asp-validation-for="Username" class="field-error"></span>
                    </div>

                    <div class="field-group">
                        <label asp-for="DisplayName"></label>
                        <input asp-for="DisplayName" class="app-input" placeholder="Display name" />
                        <span asp-validation-for="DisplayName" class="field-error"></span>
                    </div>
                </div>

                <div class="auth-actions">
                    <button type="submit" class="app-button auth-submit">Create account</button>
                </div>
            </form>

            <div class="auth-inline-link">
                <span>Already have an account?</span>
                <a asp-action="Login" asp-controller="Authentication">Login</a>
            </div>
        </div>
    </div>
</section>
