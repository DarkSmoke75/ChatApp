@using Endpoint.Site.Models.ViewModels.AuthenticationViewModel
@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<section class="auth-page">
    <div class="auth-shell auth-shell-compact">
        <div class="auth-panel auth-form-panel auth-form-panel-compact">
            <div class="auth-form-header">
                <h1>Login</h1>
                <p>Welcome back.</p>
            </div>

            <form asp-action="Login" asp-controller="Authentication" method="post" class="auth-form">
                <div asp-validation-summary="All" class="validation-summary"></div>

                <div class="field-group">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" class="app-input" placeholder="name@example.com" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <div class="field-group">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" type="password" class="app-input" placeholder="Your password" />
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <div class="auth-actions">
                    <button type="submit" class="app-button auth-submit">Login</button>
                </div>
            </form>

            <div class="auth-inline-link">
                <span>Don’t have an account?</span>
                <a asp-action="SignUp" asp-controller="Authentication">Sign up</a>
            </div>
        </div>
    </div>
</section>
