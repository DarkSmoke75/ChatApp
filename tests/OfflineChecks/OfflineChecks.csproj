<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>CS8618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll" />
    <Compile Include="../../ChatApp.Domain/Entities/**/*.cs" LinkBase="Domain" />
    <Compile Include="../../ChatApp.Application/Services/Messages/MessageDto.cs" Link="ServerMessageDto.cs" />
    <Compile Include="../../ChatApp.Application/Services/Messages/Commands/SendMessage/ResultSendMessageDto.cs" Link="ResultSendMessageDto.cs" />
    <Compile Include="../../ChatApp.Application/Services/Messages/Queries/GetMessages/GetConversationMessagesResultDto.cs" Link="HistoryMessageDto.cs" />
    <Compile Include="../../Endpoint.App/Models/Dtos/MessageDto.cs" Link="MobileMessageDto.cs" />
    <Compile Include="../../Endpoint.App/Services/Conversation/MessageTimeline.cs" Link="MessageTimeline.cs" />
  </ItemGroup>
</Project>
