<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Endpoint.App.Views.LoginPage"
             Title="LoginPage">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Sign Up" Command="{Binding RegisterCommand}" />
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <VerticalStackLayout Margin="10">
            <Label 
            Text="Welcome to Chat App"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
            <Label Text="Email" Padding="0,10,0,0"/>
            <Entry Text="{Binding Email}" Margin="10"/>
            <Label Text="Password" Padding="0,10,0,0"/>
            <Entry IsPassword="true" Text="{Binding Password}" Margin="10"/>
            <Button Text="Login" Command="{Binding LoginCommand}" Margin="10"  />
            <Button Text="Register" Command="{Binding RegisterCommand}" Margin="10" />
            <Label Text="{Binding ErrorMessage}" />
        </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage>