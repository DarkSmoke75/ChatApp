<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Endpoint.App.Views.RegisterPage"
             Title="RegisterPage"
             Shell.FlyoutBehavior="Disabled">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="primary">#ff3467</Color>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <ScrollView>
            <StackLayout Spacing="10" >
                <Label HeightRequest="50"  
                         
                          Text="Create Acount" 
                          FontSize="20" 
                          HorizontalTextAlignment="Center"
                          VerticalTextAlignment="Center"/>
                <Entry  Margin="20,0,20,0" 
                         HeightRequest="50" 
                         Placeholder="Email"
                        Text="{Binding Email}">
                </Entry>

                <Entry Margin="20,0,20,0" 
                        HeightRequest="50" IsPassword="true"
                        Placeholder="Password"
                       Text="{Binding Password}">

                </Entry>
                <Entry Margin="20,0,20,0" 
                       HeightRequest="50" IsPassword="true"
                       Placeholder="Enter Password Again"
                       Text="{Binding RePassword}">

                </Entry>
                <Entry  Margin="20,0,20,0" 
                        HeightRequest="50" 
                        Placeholder="Username"
                        Text="{Binding Username}">
                </Entry>
                <Entry  Margin="20,0,20,0" 
                        HeightRequest="50" 
                        Placeholder="DisplayName"
                        Text="{Binding DisplayName}">
                </Entry>


                <Button Margin="20,0,20,0" 
                         HeightRequest="50" 
                         TextColor="White" 
                         Text="Register"  
                         Command="{Binding SignUpCommand}"
                        />

                <Button Margin="0,0,0,20" Text="I have an account" 
                        HorizontalOptions="Center" 
                        Background="Transparent"
                        Command="{Binding BackToLoginCommand}"
                        TextColor="{StaticResource primary}"/>
            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>