<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Endpoint.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:MainPages="clr-namespace:Endpoint.App.Views"
    xmlns:ShellPages="clr-namespace:Endpoint.App.Views.MainShell"
    Title="Endpoint.App">
    <!--<ShellContent
        Route="Login"
        ContentTemplate="{DataTemplate MainPages:LoginPage}"
        Shell.FlyoutBehavior="Disabled" />-->
    
    <TabBar Route="MainTabs">
        <ShellContent Title="Home"
                      ContentTemplate="{DataTemplate MainPages:MainPage}"/>
        <ShellContent Title="Settings"
                      ContentTemplate="{DataTemplate ShellPages:SettingsPage}"/>
        <ShellContent Title="Chats"
                      ContentTemplate="{DataTemplate ShellPages:ChatsPage}"/>
        <ShellContent Title="Users"
                      ContentTemplate="{DataTemplate ShellPages:UsersPage}"/>
    </TabBar>
</Shell>
