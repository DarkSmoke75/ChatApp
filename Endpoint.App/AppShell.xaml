<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Endpoint.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:MainPages="clr-namespace:Endpoint.App.Pages"
    xmlns:ShellPages="clr-namespace:Endpoint.App.Pages.MainShell"
    Title="Endpoint.App">

    <TabBar>
        <ShellContent Title="Home"
                      ContentTemplate="{DataTemplate MainPages:MainPage}"/>
        <ShellContent Title="Settings"
                      ContentTemplate="{DataTemplate ShellPages:SettingsPage}"/>
        <ShellContent Title="Profile"
                      ContentTemplate="{DataTemplate ShellPages:ProfilePage}"/>
        <ShellContent Title="Users"
                      ContentTemplate="{DataTemplate ShellPages:UsersPage}"/>
    </TabBar>
</Shell>
